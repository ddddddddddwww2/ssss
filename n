<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Домашние торты и десерты на заказ</title>
    <style>
        :root {
            --primary: #e87a5d;
            --primary-hover: #d6684b;
            --bg-color: #fff9f6;
            --text-color: #4a3e3d;
            --card-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
        }

        /* Container */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Hero Section */
        .hero {
            padding: 60px 0 40px;
            text-align: center;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 15px;
            color: #2c2221;
        }

        .hero p {
            font-size: 1.2rem;
            margin-bottom: 25px;
            color: #6e5e5c;
        }

        .badge {
            display: inline-block;
            background: #ffe8e1;
            color: var(--primary);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: bold;
            margin-bottom: 15px;
        }

        /* Buttons */
        .btn {
            display: inline-block;
            background-color: var(--primary);
            color: white;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 30px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: background 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn:hover {
            background-color: var(--primary-hover);
        }

        /* Features Section */
        .features {
            padding: 40px 0;
        }

        .section-title {
            text-align: center;
            font-size: 1.8rem;
            margin-bottom: 30px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .card {
            background: var(--card-bg);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            text-align: center;
        }

        .card h3 {
            margin-bottom: 10px;
            color: var(--primary);
        }

        /* Catalog */
        .catalog {
            padding: 40px 0;
        }

        .price {
            font-size: 1.3rem;
            font-weight: bold;
            margin: 15px 0;
            color: #2c2221;
        }

        /* Form / CTA Section */
        .cta-section {
            background: #ffe8e1;
            padding: 40px 20px;
            border-radius: 20px;
            text-align: center;
            margin: 40px auto;
            max-width: 800px;
        }

        .cta-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
            max-width: 400px;
            margin: 20px auto 0;
        }

        .cta-form input {
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 1rem;
        }

        /* Fixed Mobile Button */
        .mobile-btn {
            display: none;
            position: fixed;
            bottom: 20px;
            left: 20px;
            right: 20px;
            background: #25D366;
            color: white;
            text-align: center;
            padding: 15px;
